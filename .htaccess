# ==============================================================================
# ILUSTRE MUNICIPALIDAD DE PUTAENDO - CONFIGURACIÓN DE CACHÉ Y COMPRESIÓN HTTP
# Optimizado para Google PageSpeed Insights & Core Web Vitals
# ==============================================================================

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # CSS y JavaScript (Caché por 1 año)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Imágenes optimizadas (Caché por 1 año)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Tipografías y fuentes web
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Cabeceras Cache-Control con Directiva Inmutable para Activos Estáticos
  <FilesMatch "\.(css|js|webp|svg|png|jpe?g|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Compresión y negociación de codificación
  <FilesMatch "\.(html|css|js|svg|json|xml)$">
    Header append Vary: Accept-Encoding
  </FilesMatch>

  # Seguridad y rendimiento
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compresión GZIP / DEFLATE
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
